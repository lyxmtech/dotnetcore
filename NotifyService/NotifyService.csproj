<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\BusCore\BusCore.csproj" />
    <!--
      The notify consumer lives in ServiceCore, a plain class library, so it
      can be unit tested. Class libraries carry no appsettings*.json, so this
      reference cannot collide with DemoHost's own configuration files.
    -->
    <ProjectReference Include="..\ServiceCore\ServiceCore.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
